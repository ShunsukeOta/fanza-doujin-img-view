{
  "name": "fanza-doujin-img-view",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "php -S 127.0.0.1:8787 server/public/router.php",
    "build": "vite build",
    "build:shin": "npm run build && node scripts/build-shin.mjs",
    "typecheck": "tsc --noEmit",
    "check:php": "find server -name '*.php' -print0 | xargs -0 -n1 php -l"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
