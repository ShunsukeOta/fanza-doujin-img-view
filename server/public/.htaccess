Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^api/(catalog|meta|diagnostics|debug|health|events|reactions|saved|me|work-details)\.php$ - [L]
  RewriteRule ^api/(catalog|meta|diagnostics|debug|health|events|reactions|saved|me|work-details)/?$ api/$1.php [L,QSA]
  RewriteRule ^api/ - [R=404,L]

  RewriteRule ^favorites/?$ /saved [R=301,L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<Files "version.json">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store, max-age=0"
  </IfModule>
</Files>
